@model WerewolfWebsite.Core.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }
<h2>Change password</h2>
<form asp-action="ChangePassword" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div><label asp-for="OldPassword"></label><input asp-for="OldPassword" /><span asp-validation-for="OldPassword"></span></div>
    <div><label asp-for="NewPassword"></label><input asp-for="NewPassword" /><span asp-validation-for="NewPassword"></span></div>
    <div><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword"></span></div>
    <button type="submit">Change password</button>
</form>
